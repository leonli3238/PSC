# Copy to .env and fill in. Real environment variables take precedence.

# OpenAI, or any OpenAI-compatible endpoint (proxy, DeepSeek, vLLM ...).
# Leave OPENAI_BASE_URL empty for the official OpenAI API.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# DashScope (Qwen), only needed for provider = "dashscope"
DASHSCOPE_API_KEY=

# Ollama, only needed for provider = "ollama", e.g. http://localhost:11434
OLLAMA_HOST=

# Self-hosted vLLM, only needed for provider = "vllm" (config.vllm.toml).
# 127.0.0.1 works when vLLM runs on this machine or through an SSH tunnel;
# otherwise use the H20 host's IP, e.g. http://10.0.0.12:8000/v1
VLLM_NODE_BASE_URL=http://127.0.0.1:8000/v1
VLLM_CURATOR_BASE_URL=http://127.0.0.1:8001/v1
# Only checked if the servers were started with --api-key
VLLM_API_KEY=EMPTY
